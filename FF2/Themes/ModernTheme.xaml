<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <!-- ============================================================ -->
    <!-- Color Palette                                                 -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="FaaPrimaryBlue"       Color="#2E5EA8"/>
    <SolidColorBrush x:Key="FaaPrimaryBlueDark"   Color="#1E3F72"/>
    <SolidColorBrush x:Key="FaaPrimaryBlueLight"  Color="#E8EEF7"/>
    <SolidColorBrush x:Key="FaaBackgroundGray"    Color="#F5F6F8"/>
    <SolidColorBrush x:Key="FaaSurfaceWhite"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FaaBorderGray"        Color="#D1D5DB"/>
    <SolidColorBrush x:Key="FaaBorderGrayLight"   Color="#E5E7EB"/>
    <SolidColorBrush x:Key="FaaTextPrimary"       Color="#1F2937"/>
    <SolidColorBrush x:Key="FaaTextSecondary"     Color="#6B7280"/>
    <SolidColorBrush x:Key="FaaValidationRed"     Color="#DC2626"/>
    <SolidColorBrush x:Key="FaaHoverGray"         Color="#F0F1F3"/>
    <SolidColorBrush x:Key="FaaFocusBorder"       Color="#6B8DC7"/>
    <SolidColorBrush x:Key="FaaToolbarBg"         Color="#FAFBFC"/>

    <!-- Easing function for animations -->
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <!-- ============================================================ -->
    <!-- Typography Styles (keyed)                                     -->
    <!-- ============================================================ -->
    <Style x:Key="TypeHeadingLarge" TargetType="FrameworkElement">
        <Setter Property="TextElement.FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.FontSize"   Value="18"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TypeHeadingMedium" TargetType="FrameworkElement">
        <Setter Property="TextElement.FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.FontSize"   Value="15"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TypeHeadingSmall" TargetType="FrameworkElement">
        <Setter Property="TextElement.FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.FontSize"   Value="14"/>
        <Setter Property="TextElement.FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="TypeTitle" TargetType="FrameworkElement">
        <Setter Property="TextElement.FontFamily" Value="Segoe UI"/>
        <Setter Property="TextElement.FontSize"   Value="16"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============================================================ -->
    <!-- Button Style (implicit)                                       -->
    <!-- ============================================================ -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Padding"    Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{StaticResource FaaBorderGray}"
                            Background="{StaticResource FaaToolbarBg}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#F0F1F3" Duration="0:0:0.15"
                                                        EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FAFBFC" Duration="0:0:0.15"
                                                        EasingFunction="{StaticResource EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#D1D5DB" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FAFBFC" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- TextBox Focus Animation (implicit)                            -->
    <!-- ============================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily"     Value="Segoe UI"/>
        <Setter Property="FontSize"       Value="13"/>
        <Setter Property="Padding"        Value="4,3"/>
        <Setter Property="BorderBrush"    Value="{StaticResource FaaBorderGray}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)"
                                            To="#6B8DC7" Duration="0:0:0.2"
                                            EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)"
                                            To="#D1D5DB" Duration="0:0:0.2"
                                            EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!-- DataGridRow Hover (implicit)                                  -->
    <!-- ============================================================ -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)"
                                            To="#F0F1F3" Duration="0:0:0.15"
                                            EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)"
                                            To="Transparent" Duration="0:0:0.2"
                                            EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource FaaPrimaryBlueLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!-- DataGridColumnHeader Style (implicit)                         -->
    <!-- ============================================================ -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{StaticResource FaaPrimaryBlue}"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="Padding"     Value="6,8"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="BorderBrush" Value="{StaticResource FaaBorderGrayLight}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- ============================================================ -->
    <!-- RadPane Fade-In (keyed style)                                 -->
    <!-- ============================================================ -->
    <Style x:Key="AnimatedPaneStyle" TargetType="telerik:RadPane">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.25"
                                         EasingFunction="{StaticResource EaseOut}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!-- GroupBox Refinement (implicit)                                 -->
    <!-- ============================================================ -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource FaaBorderGray}"/>
        <Setter Property="Padding"     Value="8"/>
        <Setter Property="Foreground"  Value="{StaticResource FaaPrimaryBlue}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
    </Style>

    <!-- ============================================================ -->
    <!-- Label Style (implicit)                                        -->
    <!-- ============================================================ -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource FaaTextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- ============================================================ -->
    <!-- Toolbar Shadow Border (keyed)                                 -->
    <!-- ============================================================ -->
    <Style x:Key="ToolbarShadowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FaaToolbarBg}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1"
                                  BlurRadius="4"
                                  Opacity="0.08"
                                  Direction="270"
                                  Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
