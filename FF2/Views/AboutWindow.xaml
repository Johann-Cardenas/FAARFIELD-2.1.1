<Window x:Class="Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FAARFIELD CM"
        Width="580" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="8" Background="White"
            BorderBrush="#B0BEC5" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#37474F"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- HEADER — teal gradient with version badge      -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Padding="28,22,28,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#004D40" Offset="0"/>
                        <GradientStop Color="#00695C" Offset="0.35"/>
                        <GradientStop Color="#00897B" Offset="0.7"/>
                        <GradientStop Color="#26A69A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title stack -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FAARFIELD" FontSize="28" FontWeight="Bold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                            <!-- Version pill -->
                            <Border Background="#004D40" CornerRadius="10" Padding="10,3"
                                    Margin="12,6,0,0" VerticalAlignment="Top">
                                <TextBlock Text="v2.1.1-CM" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#80CBC4" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Customized Edition" FontSize="15" Foreground="#B2DFDB"
                                   FontFamily="Segoe UI" Margin="0,2,0,0" FontWeight="Light"/>
                        <TextBlock Text="Computational Mechanics Build" FontSize="11"
                                   Foreground="#80CBC4" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BuildDateText" FontSize="10" Foreground="#4DB6AC"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Close button (top-right) -->
                    <Button Grid.Column="1" Content="&#x2715;" FontSize="14" Foreground="White"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Cursor="Hand" Click="CloseButton_Click" ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="closeBg" Background="Transparent"
                                                    CornerRadius="4" Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="closeBg" Property="Background"
                                                            Value="#00796B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- BODY — vertical scroll only, no horizontal     -->
            <!-- ═══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,16">

                    <!-- ── BETA DISCLOSURE ── -->
                    <Border CornerRadius="5" Margin="0,0,0,18" ClipToBounds="True">
                        <Grid>
                            <!-- Amber left accent bar -->
                            <Border Background="#FF8F00" Width="5" HorizontalAlignment="Left"/>
                            <Border Background="#FFF8E1" Padding="18,14,16,14" Margin="5,0,0,0"
                                    BorderBrush="#FFE082" BorderThickness="0,1,1,1">
                                <StackPanel>
                                    <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#E65100"
                                               FontFamily="Segoe UI">
                                        &#x26A0;  Beta Software — Not an Official FAA Release
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#4E342E"
                                               FontFamily="Segoe UI" Margin="0,8,0,0" LineHeight="18">
                                        This is a customized beta version of FAARFIELD currently under
                                        active development. It is <Bold>not</Bold> the official release of
                                        FAARFIELD published by the Federal Aviation Administration.
                                        Computational results produced by this build may differ from those
                                        of the certified FAA distribution and should be independently
                                        verified before use in any regulatory or design context.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── DESCRIPTION ── -->
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#37474F"
                               FontFamily="Segoe UI" LineHeight="19" Margin="0,0,0,18">
                        FAARFIELD (FAA Rigid and Flexible Iterative Elastic Layered Design)
                        implements layered elastic theory, 3-D finite element analysis,
                        cumulative damage factor computation, and ACN/PCN classification for
                        airfield pavement thickness design. This customized edition extends
                        the original software with enhanced reporting, expanded engineering
                        guardrail documentation, and computational mechanics visualizations
                        — including the CM Report with detailed design trace analytics.
                    </TextBlock>

                    <!-- ── WHAT'S NEW ── -->
                    <Border Background="#E0F2F1" CornerRadius="5" Padding="16,12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="What's New in This Build" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#00695C" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"
                                           Margin="0,0,0,4">
                                    <Run Text="&#x2022;" Foreground="#00897B" FontWeight="Bold"/>
                                    <Run Text="  CM Report"/> <Run Text="— computational mechanics trace with 15 sections" Foreground="#546E7A"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"
                                           Margin="0,0,0,4">
                                    <Run Text="&#x2022;" Foreground="#00897B" FontWeight="Bold"/>
                                    <Run Text="  Gear Configuration Visualization"/> <Run Text="— plan-view wheel positions with CDF strips" Foreground="#546E7A"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"
                                           Margin="0,0,0,4">
                                    <Run Text="&#x2022;" Foreground="#00897B" FontWeight="Bold"/>
                                    <Run Text="  Native HTML/SVG Reports"/> <Run Text="— scalable vector charts, print-ready" Foreground="#546E7A"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"
                                           Margin="0,0,0,4">
                                    <Run Text="&#x2022;" Foreground="#00897B" FontWeight="Bold"/>
                                    <Run Text="  Annual Departure Limit"/> <Run Text="— raised from 100,000 to 500,000" Foreground="#546E7A"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#37474F" FontFamily="Segoe UI">
                                    <Run Text="&#x2022;" Foreground="#00897B" FontWeight="Bold"/>
                                    <Run Text="  48 Engineering Guardrails"/> <Run Text="— fully documented in README" Foreground="#546E7A"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── SEPARATOR ── -->
                    <Border Height="1" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#B0BEC5" Offset="0.2"/>
                                <GradientStop Color="#B0BEC5" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ── CREDITS ── -->
                    <TextBlock Text="Credits" FontSize="13" FontWeight="SemiBold"
                               Foreground="#00695C" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Customization by"
                                   FontSize="11" Foreground="#78909C" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" FontSize="11" FontFamily="Segoe UI">
                            <Run Text="Johann Cardenas" FontWeight="SemiBold" Foreground="#37474F"/>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Purpose"
                                   FontSize="11" Foreground="#78909C" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" Text="Computational Mechanics Research"
                                   FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Original software"
                                   FontSize="11" Foreground="#78909C" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" Text="Federal Aviation Administration (FAA)"
                                   TextWrapping="Wrap" FontSize="11" Foreground="#37474F"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Original authors"
                                   FontSize="11" Foreground="#78909C" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#37474F" FontFamily="Segoe UI">
                            Dr. Izydor Kawa, Y. G. Chen, Qiang Wang, Kairat Assemblayev
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Base version"
                                   FontSize="11" Foreground="#78909C" FontFamily="Segoe UI"/>
                        <TextBlock Grid.Column="1" Text="FAARFIELD 2.1.1 (.NET Framework 4.8)"
                                   FontSize="11" Foreground="#37474F" FontFamily="Segoe UI"/>
                    </Grid>

                    <!-- ── SEPARATOR ── -->
                    <Border Height="1" Margin="0,12,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#B0BEC5" Offset="0.2"/>
                                <GradientStop Color="#B0BEC5" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- ── LICENSE AND DISCLAIMER ── -->
                    <TextBlock Text="License and Disclaimer" FontSize="13" FontWeight="SemiBold"
                               Foreground="#00695C" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#546E7A"
                               FontFamily="Segoe UI" LineHeight="17">
                        This customized version is provided freely for educational, research,
                        and engineering purposes. You may use, copy, and distribute this
                        software without restriction. However, this software is provided
                        <Bold>"as is"</Bold>, without warranty of any kind, express or implied,
                        including but not limited to the warranties of merchantability, fitness
                        for a particular purpose, and noninfringement.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#546E7A"
                               FontFamily="Segoe UI" LineHeight="17" Margin="0,8,0,0">
                        In no event shall the author of this customization be held liable for
                        any claim, damages, or other liability arising from the use of this
                        software. The user assumes full responsibility for verifying all
                        computational results and for any decisions made based on those results.
                        This software is not endorsed by, affiliated with, or certified by the
                        Federal Aviation Administration.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#546E7A"
                               FontFamily="Segoe UI" LineHeight="17" Margin="0,8,0,0">
                        The original FAARFIELD source code remains the intellectual property
                        of the Federal Aviation Administration. All rights to the original
                        code are retained by the FAA.
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- FOOTER                                         -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,8,8"
                    Padding="28,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="10" Foreground="#90A4AE" FontFamily="Segoe UI">
                        &#x00A9; 2025–2026 Johann Cardenas. Original FAARFIELD &#x00A9; FAA.
                    </TextBlock>
                    <Button Content="  I Understand — Continue  " HorizontalAlignment="Right"
                            Click="CloseButton_Click" IsDefault="True" IsCancel="True"
                            FontFamily="Segoe UI" FontSize="11.5">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="#00796B"
                                                    CornerRadius="5" Padding="18,8" Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder"
                                                            Property="Background" Value="#00897B"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder"
                                                            Property="Background" Value="#004D40"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
