<Window x:Class="Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:converters="clr-namespace:FF2.Converters"
        xmlns:utils="clr-namespace:FF2.Utilities"
        xmlns:validation="clr-namespace:FF2.ValidationRules"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        mc:Ignorable="d"
        Height="768"
        Width="1265"
        WindowStartupLocation="CenterScreen"
        Title="{Binding MainWindowTitle}"
        WindowState="{Binding WindowState, Mode=TwoWay}"
        DataContext="{StaticResource MainWindowViewModel}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding OnNewJob_Command}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OnOpenJob_Command}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding OnSaveJob_Command}"/>
        <KeyBinding Key="F1" Command="{Binding OnHelp_Command}"/>
    </Window.InputBindings>

    <i:Interaction.Behaviors>
        <utils:EventToCommandBehavior Command="{Binding Window_Closing_Command}" Event="Closing" PassArguments="True" />
        <utils:EventToCommandBehavior Command="{Binding Window_Loaded_Command}" Event="Loaded" PassArguments="True" />
    </i:Interaction.Behaviors>

    <DockPanel x:Name="FaarField" DataContext="{StaticResource MainWindowViewModel}">

        <telerik:RadToolBar DockPanel.Dock="Top">
            <Button Content="{StaticResource NewJobButton}"
                ToolTip="Create a new FAARFIELD Job (Ctrl+N)"
                Command="{Binding OnNewJob_Command}" />
            <Button Content="{StaticResource OpenJobButton}"
                ToolTip="Open an existing FAARFIELD Job (Ctrl+O)"
                Command="{Binding OnOpenJob_Command}" />
            <Button Content="{StaticResource NewSectionButton}"
                ToolTip="Create a new analysis structure in the active FAARFIELD job.  If a Job is not open, both a new Job and new Structure will be created."
                Command="{Binding OnSectionNew_Command}" />
            <Button Content="{StaticResource SaveJobButton}"
                ToolTip="Save current active FAARFIELD Job (Ctrl+S)"
                Command="{Binding OnSaveJob_Command}" />
            <Button Content="{StaticResource SaveAsJobButton}"
                ToolTip="Save current FAARFIELD Job under new name.  Existing FAARFIELD Job will remain in your Save folder."
                Command="{Binding OnSaveAsJob_Command}" />
            <Button Content="{StaticResource SaveAllJobButton}"
                ToolTip="Save all open FAARFIELD Job files"
                Command="{Binding OnSaveAllJob_Command}" />
            <Button Content="{StaticResource CloseJobButton}"
                ToolTip="Close active FAARFIELD Job.  If the Job has unsaved data you will be prompted to save the job before the file closes."
                Command="{Binding OnCloseJob_Command}" />
            <telerik:RadToolBarSeparator />
            <Label Content="AIRCRAFT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaaTextSecondary}" VerticalAlignment="Center"/>            
            <Button Content="{StaticResource ImportButton}"
                ToolTip="Create New User Defined Aircraft"               
                Command="{Binding OnCreateUserDefined_Command}"/>
            <Button Content="{StaticResource ExportButton}"
                ToolTip="Edit User Defined Aircraft"
                Command="{Binding OnEditUserDefined_Command}"/>            
            <telerik:RadToolBarSeparator />
            <Label Content="BATCH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaaTextSecondary}" VerticalAlignment="Center"/>
            <Button Content="{StaticResource SelectAllButton}"
                ToolTip="Select all structures for Batch Run"
                Command="{Binding OnSelectAllSections_Command}"/>
            <Button Content="{StaticResource DeSelectAllButton}"
                ToolTip="Remove all structures from Batch Run"
                Command="{Binding OnDeSelectAllSections_Command}"/>
            <telerik:RadToolBarSeparator />
            <Button Content="{StaticResource PaveAirActionsButton}"
                    ToolTip="Open DOM access tab"
                    Command="{Binding OnOpenDomAccessTab_Command}"/>
            <Button Content="{StaticResource ExitButton}"
                ToolTip="Closes the software"
                Command="{Binding ExitApp_Command}"
                telerik:RadToolBar.ItemAlignment="Right" />
            <Button Content="{StaticResource ResetButton}"
                ToolTip="Reset the layout of FAARFIELD to the default state."
                Command="{Binding OnReset_Command}"
                telerik:RadToolBar.ItemAlignment="Right" />
            <Button Content="{StaticResource HelpButton}"
                ToolTip="Display FAARFIELD help documentation (F1)"
                Command="{Binding OnHelp_Command}"
                telerik:RadToolBar.ItemAlignment="Right" />
            <Button Content="{StaticResource AboutButton}"
                ToolTip="About this customized version of FAARFIELD."
                Command="{Binding OnAbout_Command}"
                telerik:RadToolBar.ItemAlignment="Right" />
        </telerik:RadToolBar>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource FaaToolbarBg}"
                   BorderBrush="{StaticResource FaaBorderGrayLight}"
                   BorderThickness="0,1,0,0"
                   FontSize="11">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentJob.Name, StringFormat='Job: {0}', FallbackValue='No job open'}"
                           Foreground="{StaticResource FaaTextSecondary}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentSectionView.Section.Name, StringFormat='Structure: {0}', FallbackValue=''}"
                           Foreground="{StaticResource FaaTextSecondary}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding AnalysisType.Name, FallbackValue=''}"
                           Foreground="{StaticResource FaaTextSecondary}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
        <telerik:RadDocking ShowResizePreview="True" x:Name="Docking" GeneratedItemsFactory="{StaticResource NonTransparentWindowsGeneratedItemsFactory}" telerik:RadDocking.SerializationTag="MainDockingTag" Width="{Binding ActualWidth, ElementName=FaarField}">

            <telerik:RadDocking.DocumentHost>

                <!-- DOCK TOP CENTER MAIN CONTAINER -->
                <telerik:RadSplitContainer telerik:RadDocking.FloatingSize="1050,640" BorderThickness="{Binding JobViewBorderThickness}" telerik:RadDocking.SerializationTag="MainContainerTag">
                    <telerik:RadPaneGroup telerik:RadDocking.SerializationTag="MainGroupTag">

                        <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" Header="Job Information"
                                        IsHidden="{Binding JobInformationIsHidden,  Mode=TwoWay}"
                                        DataContext="{StaticResource MainWindowViewModel}"
                                        telerik:RadDocking.SerializationTag="JobInformation">
                            <ScrollViewer>
                                <Canvas Width="1000"
                                    Height="600"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Label Canvas.Top="5"
                                        Canvas.Left="5">Job Name:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Left="80"
                                            Canvas.Top="5"
                                            Text="{Binding Path=CurrentJob.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                        <telerik:EventToCommandBehavior.EventBindings>
                                            <telerik:EventBinding Command="{Binding OnValidateJobName}"
																EventName="LostFocus" PassEventArgsToCommand="True"/>
                                        </telerik:EventToCommandBehavior.EventBindings>
                                    </TextBox>
                                    <Label  Canvas.Top="5"
                                        Canvas.Left="300">Location identifier:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="5"
                                            Canvas.Left="440"
                                            Text="{Binding Path=CurrentJob.JobInformation.LocationIdentifier}" />
                                    
                                    <Label  Canvas.Top="5"
                                        Canvas.Left="660">Country:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="5"
                                            Canvas.Left="780"
                                            Text="{Binding Path=CurrentJob.JobInformation.Country}" />
                                    <Label Canvas.Top="42"
                                        Canvas.Left="5">State:</Label>
                                    <TextBox Canvas.Left="80"
                                            Canvas.Top="42"
                                            Height="30"
                                            Width="200"
                                            Text="{Binding Path=CurrentJob.JobInformation.State}" />
                                    <Label  Canvas.Top="42"
                                        Canvas.Left="300">City:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="42"
                                            Canvas.Left="440"
                                            Text="{Binding Path=CurrentJob.JobInformation.City}" />
                                    <Label  Canvas.Top="42"
                                        Canvas.Left="660">Airport:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="42"
                                            Canvas.Left="780"
                                            Text="{Binding Path=CurrentJob.JobInformation.Airport}"
                                            MaxLength="4" />
                                    <Label Canvas.Top="80"
                                        Canvas.Left="5">AIP project number:</Label>
                                    <TextBox Canvas.Left="150"
                                            Canvas.Top="80"
                                            Height="30"
                                            Width="130"
                                            Text="{Binding Path=CurrentJob.JobInformation.AipProjectNumber}" />
                                    <Label  Canvas.Top="80"
                                        Canvas.Left="300">Sponsor:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="80"
                                            Canvas.Left="440"
                                            Text="{Binding Path=CurrentJob.JobInformation.Sponsor}" />
                                    <Label  Canvas.Top="80"
                                        Canvas.Left="660">Design engineer:</Label>
                                    <TextBox Width="200"
                                            Height="32"
                                            Canvas.Top="80"
                                            Canvas.Left="780"
                                            Text="{Binding Path=CurrentJob.JobInformation.DesignEngineer}" />
                                    <Label Canvas.Top="120"
                                        Canvas.Left="5">Project description:</Label>
                                    <TextBox Canvas.Left="5"
                                            Canvas.Top="150"
                                            Width="975"
                                            Height="100"
                                            Text="{Binding Path=CurrentJob.JobInformation.Description}" />
                                    <GroupBox Width="975"
                                            Canvas.Left="5"
                                            Canvas.Top="260"
                                            Height="100">
                                        <GroupBox.Header>Subgrade Characteristics</GroupBox.Header>
                                        <Canvas>
                                            <Label Name="LabelFrostPenetrationDepth"
                                                Canvas.Top="15"
                                                Content="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemAverageFrost}}">
                                            </Label>
                                            <TextBox Name="FrostPenetrationDepth"
                                                    Canvas.Top="15"
                                                    Canvas.Left="250"
                                                    Width="60"
                                                    Height="30">
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource ThicknessConverter}">
                                                        <Binding  Path="CurrentJob.JobInformation.FrostDepth" />
                                                        <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                                <telerik:EventToCommandBehavior.EventBindings>
                                                    <telerik:EventBinding Command="{Binding OnValidateJobInformation}"
                                                                        EventName="LostFocus" />
                                                </telerik:EventToCommandBehavior.EventBindings>
                                            </TextBox>
                                            <Label Canvas.Top="15"
                                                Canvas.Left="330">Surface drainage:</Label>
                                            <ComboBox Name="SurfaceDrainage"
                                                    Canvas.Top="15"
                                                    Canvas.Left="450"
                                                    Width="150"
                                                    Height="30"
                                                    Text="{Binding Path=CurrentJob.JobInformation.SurfaceDrainage}">
                                                <ComboBoxItem Content="Standard" />
                                            </ComboBox>
                                            <Label Canvas.Top="15"
                                                Canvas.Left="620">Frost design method:</Label>
                                            <ComboBox Name="FrostMethod"
                                                    Canvas.Top="15"
                                                    Canvas.Left="770"
                                                    Width="150"
                                                    Height="30"
                                                    Text="{Binding Path=CurrentJob.JobInformation.FrostDesign}">
                                                <ComboBoxItem Content="Standard" />
                                            </ComboBox>
                                            <TextBlock  Name="WarningFrost"
                                                    Foreground="{StaticResource FaaErrorRed}"
                                                    Canvas.Top="45"
                                                    Visibility="{Binding WarningFrostPenetrationHidden}"
                                                    Text="{Binding Path=CurrentJob.DesignOptions.MeasurementSystem, Converter={StaticResource FrostPenetrationWarning}}"/>
                                        </Canvas>
                                    </GroupBox>

                                    <Label Canvas.Top="370"
                                        Canvas.Left="5">Comments:</Label>
                                    <TextBox Canvas.Left="5"
                                            Canvas.Top="400"
                                            Width="975"
                                            Height="100"
                                            Text="{Binding Path=CurrentJob.JobInformation.Comments}" />

                                    <GroupBox Canvas.Left="5"
                                            Canvas.Top="510"
                                            Height="100"
                                            Width="975">
                                        <GroupBox.Header>Pavement Management Tracking</GroupBox.Header>
                                        <Canvas>
                                            <Label Canvas.Top="15">Network:</Label>
                                            <TextBox Canvas.Top="15"
                                                    Canvas.Left="70"
                                                    Width="200"
                                                    Height="32"
                                                    Text="{Binding Path=CurrentJob.JobInformation.Network}" />
                                            <Label Canvas.Top="15"
                                                Canvas.Left="280">Branch:</Label>
                                            <TextBox Canvas.Top="15"
                                                    Canvas.Left="340"
                                                    Width="200"
                                                    Height="32"
                                                    Text="{Binding Path=CurrentJob.JobInformation.Branch}" />
                                            <Label Canvas.Top="15"
                                                Canvas.Left="550">Section:</Label>
                                            <TextBox Canvas.Top="15"
                                                    Canvas.Left="620"
                                                    Width="200"
                                                    Height="32"
                                                    Text="{Binding Path=CurrentJob.JobInformation.Section}" />
                                        </Canvas>
                                    </GroupBox>

                                </Canvas>
                            </ScrollViewer>

                        </telerik:RadPane>

                        <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" Header="Structure"
										Name="SectionScreen"
										IsHidden="{Binding SectionIsHidden,  Mode=TwoWay}"
										DataContext="{StaticResource MainWindowViewModel}"
										telerik:RadDocking.SerializationTag="Structure">

                            <telerik:RadDocking x:Name="InnerDock" HasDocumentHost="False" telerik:RadDocking.SerializationTag="InnerDocking">

                                <telerik:RadSplitContainer Orientation="Vertical" telerik:ProportionalStackPanel.RelativeSize="1000, 1000" telerik:RadDocking.SerializationTag="StructureSplitContainer" DataContext="{StaticResource MainWindowViewModel}"  InitialPosition="DockedTop">

                                    <i:Interaction.Behaviors>                                        
                                        <utils:EventToCommandBehavior Command="{Binding Structure_Loaded_Command}" Event="Loaded" PassArguments="True" />
                                    </i:Interaction.Behaviors>

                                    <!-- SECTION CONTAINER -->
                                    <telerik:RadPaneGroup telerik:ProportionalStackPanel.RelativeSize="1000, 700" telerik:RadDocking.SerializationTag="StructureGroup" DataContext="{StaticResource MainWindowViewModel}">
                                        <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" Header="Structure"
                                                         telerik:RadDocking.SerializationTag="Section" DataContext="{StaticResource MainWindowViewModel}"
                                                         IsHidden="{Binding InnerSectionIsHidden,  Mode=TwoWay}" >
                                            
                                            <ScrollViewer>
                                                <Canvas Width="1200"
                                                        Height="640"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                    <Label  Canvas.Top="5">Job Name:</Label>
                                                    <TextBox Width="200"
                                                             Height="32"
                                                             Canvas.Top="5"
                                                             Canvas.Left="110"
                                                             Text="{Binding Path=CurrentJob.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                        <!-- TODO: Should use two-way binding with validation in setter -->
                                                        <telerik:EventToCommandBehavior.EventBindings>
                                                            <telerik:EventBinding Command="{Binding OnValidateJobName}"
																EventName="LostFocus" PassEventArgsToCommand="True"/>
                                                        </telerik:EventToCommandBehavior.EventBindings>
                                                    </TextBox>
                                                    <ComboBox x:Name="TestCB"
                                                              Canvas.Top="5"
                                                              Height="32"
                                                              Canvas.Left="320"
                                                              Width="180"
                                                              SelectedIndex="{Binding Path=CurrentSectionView.Section.SelectedRun, Mode=TwoWay}" >

                                                        <!-- TODO: REPLACE INTERACTION - Use Binding inplace of  -->
                                                        <i:Interaction.Behaviors>
                                                            <utils:EventToCommandBehavior Command="{Binding RunComboBox_Changed_Command}" Event="SelectionChanged" PassArguments="True" />
                                                        </i:Interaction.Behaviors>

                                                        <!-- TODO: Set items as source list? -->
                                                        <ComboBox.Items>
                                                            <ComboBoxItem Content="Thickness Design"/>
                                                            <ComboBoxItem Content="Life"/>
                                                            <ComboBoxItem Content="Life/Compaction" IsEnabled="{Binding CompactionLifeIsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                                            <ComboBoxItem Content="PCR"/>
                                                        </ComboBox.Items>

                                                    </ComboBox>
                                                    <Button Name="RunButton"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Width="120"
                                                            Height="30"
                                                            Canvas.Top="5"
                                                            Canvas.Left="520"
                                                            Content="{Binding RunButtonText}"
                                                            Command="{Binding RunButton_Command}" >
                                                    </Button>
                                                    <Label  Canvas.Top="40">Structure Name:</Label>
                                                    <TextBox Name="SectionName"
                                                             Width="200"
                                                             Height="32"
                                                             Canvas.Top="40"
                                                             Canvas.Left="110"
                                                             Text="{Binding Path=CurrentSectionView.Section.Name, Mode=TwoWay}">

                                                        <i:Interaction.Behaviors>
                                                            <utils:EventToCommandBehavior Command="{Binding OnValidateSectionName}" Event="LostFocus" PassArguments="True" />
                                                        </i:Interaction.Behaviors>

                                                    </TextBox>
                                                    <Label Name="WarningSectionName" Foreground="{StaticResource FaaErrorRed}" Canvas.Top="65" Visibility="{Binding WarningCdfToleranceHidden}">Structure names are allowed upper and lower case letters, numbers and common punctuation.</Label>
                                                    <CheckBox Name="IncludeInSummary"
                                                              Canvas.Top="45"
                                                              Canvas.Left="320"
                                                              IsChecked="{Binding Path=CurrentSectionView.Section.IncludeInSummary}">Include in Summary Report</CheckBox>

                                                    <CheckBox Canvas.Top="45"
                                                              Canvas.Left="520"
                                                              IsChecked="{Binding Path=CurrentSectionView.Section.RunBatch}"
                                                              Command="{Binding AddToBatch_Command}" >Add To Batch</CheckBox>

                                                    <GroupBox Canvas.Top="80"
                                                              Width="640"
                                                              Height="315">
                                                        <GroupBox.Header>Pavement Layers</GroupBox.Header>
                                                        <Canvas>
                                                            <Label Canvas.Top="2" Canvas.Left="10">Pavement Type:</Label>
                                                            <ComboBox Canvas.Top="5"
                                                                      Name="AnalysisList"
                                                                      Canvas.Left="140"
                                                                      Width="300"
                                                                      ItemsSource="{Binding Path=ListAnalysis}"
                                                                      SelectedValue="{Binding Path=AnalysisType, Mode=TwoWay}"
                                                                      SelectedIndex="{Binding Path=AnalysisListSelectedIndex, Mode=TwoWay}" >
                                                            </ComboBox>

                                                            <Button Padding="0"
                                                                    Height="30"
                                                                    Width="190"
                                                                    Canvas.Left="245"
                                                                    Canvas.Top="256"
                                                                    IsEnabled="{Binding Path=SelectDesignLayerEnabled}"
                                                                    Command="{Binding SelectDesignLayerCommand}">Select As The Design Layer</Button>
                                                            <Button Padding="0"
                                                                    Height="30"
                                                                    Width="160"
                                                                    Canvas.Left="455"
                                                                    Canvas.Top="256"
                                                                    Command="{Binding DeleteselectedLayerCommand}">Delete Selected Layer</Button>

                                                            <DataGrid x:Name="StructureGrid"
                                                                      CanUserDeleteRows="False"
                                                                      CanUserAddRows="False"
                                                                      AllowDrop="True"
                                                                      AutoGenerateColumns="False"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Top"
                                                                      Canvas.Top="40"
                                                                      Width="630"
                                                                      Height="210"
                                                                      SelectedItem="{Binding SelectedMaterial}"
                                                                      ItemsSource="{Binding Path=CurrentLayers, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}">

                                                                <i:Interaction.Behaviors>
                                                                    <utils:EventToCommandBehavior Command="{Binding Dg1_Keyup_Command}" Event="KeyUp" PassArguments="True" />
                                                                    <utils:EventToCommandBehavior Command="{Binding Dg1_LostFocus_Command}" Event="LostFocus" PassArguments="True" />
                                                                    <utils:EventToCommandBehavior Command="{Binding DropMaterial_Command}" Event="Drop" PassArguments="True" />
                                                                    <utils:EventToCommandBehavior Command="{Binding DataGridBeginEdit_Command}" Event="BeginningEdit" PassArguments="True" />
                                                                    <utils:EventToCommandBehavior Command="{Binding DataGridEndEdit_Command}" Event="CellEditEnding" PassArguments="True" />
                                                                    <utils:EventToCommandBehavior Command="{Binding Dg1_CellChanged_Command}" Event="CurrentCellChanged" PassArguments="True" />
                                                                </i:Interaction.Behaviors>

                                                                <DataGrid.RowValidationRules>
                                                                    <validation:SubgradRowValidationRule ValidationStep="UpdatedValue" />
                                                                    <StaticResource ResourceKey="SubgradRowValidationRule" />
                                                                </DataGrid.RowValidationRules>

                                                                <DataGrid.ColumnHeaderStyle>
                                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WrappingColumnHeader}"/>
                                                                </DataGrid.ColumnHeaderStyle>

                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header=""
                                                                                        Binding="{Binding DesignedLayer}"
                                                                                        FontSize="16"
                                                                                        FontWeight="Bold"
                                                                                        Width="30"
                                                                                        IsReadOnly="True"
                                                                                        CanUserSort="False">
                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="True" />
                                                                                <Setter Property="Background" Value="White" />
                                                                                <Setter Property="Foreground" Value="red" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>
                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn Header="Material"
                                                                                        Binding="{Binding Name, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                                        Width="240"
                                                                                        IsReadOnly="True"
                                                                                        CanUserSort="False">
                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="True" />
                                                                                <Setter Property="Background" Value="{StaticResource FaaBackgroundGray}" />
                                                                                <Setter Property="Foreground" Value="Black" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>
                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn MinWidth="70"
                                                                                        Width="*"
                                                                                        CanUserSort="False"
                                                                                        Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemThickness}, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" >

                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="{Binding Path=Name,Converter={StaticResource ThicknessVisibilityConverter}}" />
                                                                                <Setter Property="Background" Value="{Binding Path=Name,Converter={StaticResource ThicknessBackgroundColorConverter}}" />
                                                                                <Setter Property="Foreground" Value="{Binding Path=Name,Converter={StaticResource ThicknessForegroundColorConverter}}" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>

                                                                        <DataGridTextColumn.Binding>
                                                                            <MultiBinding Converter="{StaticResource ThicknessConverter}">
                                                                                <Binding Path="Thickness" />
                                                                                <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                                            </MultiBinding>
                                                                        </DataGridTextColumn.Binding>

                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn Width="90"
                                                                                        CanUserSort="False"
                                                                                        Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemModulus}, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" >

                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="{Binding Path=Name,Converter={StaticResource ModulusEnabledConverter}}" />
                                                                                <Setter Property="Foreground" Value="{Binding Path=Name,Converter={StaticResource ModulusForegroundColorConverter}}" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>

                                                                        <DataGridTextColumn.Binding>
                                                                            <MultiBinding Converter="{StaticResource ModulusConverter}">
                                                                                <Binding Path="Modulus" />
                                                                                <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                                            </MultiBinding>
                                                                        </DataGridTextColumn.Binding>

                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn Width="90"
                                                                                        CanUserSort="False"
                                                                                        Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemSubgradeReaction}}"
                                                                                        Visibility="{Binding Source={StaticResource MainWindowViewModel}, Path = AnalysisType, Converter={StaticResource RigidVisibilityConverter}}" >

                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="{Binding Path=SubgradeReaction,Converter={StaticResource ReadOnlyConverter}}" />
                                                                                <Setter Property="Background" Value="{Binding Path=SubgradeReaction,Converter={StaticResource BackgroundColorConverter}}" />
                                                                                <Setter Property="Foreground" Value="Black" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>

                                                                        <DataGridTextColumn.Binding>
                                                                            <MultiBinding Converter="{StaticResource SubgradeReactionConverter}">
                                                                                <Binding Path="SubgradeReaction" />
                                                                                <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                                            </MultiBinding>
                                                                        </DataGridTextColumn.Binding>

                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn  Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem, Converter={StaticResource MeasurementSystemModulusOfRupture}}"
                                                                                         Visibility="{Binding Source={StaticResource MainWindowViewModel}, Path = AnalysisType , Converter={StaticResource RigidVisibilityConverter}}"
                                                                                         Width="50"
                                                                                         CanUserSort="False" >

                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="{Binding Path=Rupture,Converter={StaticResource ReadOnlyConverter}}" />
                                                                                <Setter Property="Background" Value="{Binding Path=Rupture,Converter={StaticResource BackgroundColorConverter}}" />
                                                                                <Setter Property="Foreground" Value="Black" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>

                                                                        <DataGridTextColumn.Binding>
                                                                            <MultiBinding Converter="{StaticResource ModulusConverter}">
                                                                                <Binding Path="Rupture" />
                                                                                <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                                            </MultiBinding>
                                                                        </DataGridTextColumn.Binding>

                                                                    </DataGridTextColumn>

                                                                    <DataGridTextColumn Header="CBR"
                                                                                        Width="*"
                                                                                        CanUserSort="False"
                                                                                        Visibility="{Binding Source={StaticResource MainWindowViewModel}, Path=AnalysisType, Converter={StaticResource FlexibleVisibilityConverter}}" >

                                                                        <DataGridTextColumn.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="IsEnabled" Value="{Binding Path=Cbr,Converter={StaticResource DoubleReadOnlyConverter}}" />
                                                                                <Setter Property="Background" Value="{Binding Path=Cbr,Converter={StaticResource DoubleBackgroundColorConverter}}" />
                                                                                <Setter Property="Foreground" Value="Black" />
                                                                            </Style>
                                                                        </DataGridTextColumn.CellStyle>

                                                                        <DataGridTextColumn.Binding>
                                                                            <MultiBinding Converter="{StaticResource CbrConverter}">
                                                                                <Binding Path="Cbr" />
                                                                                <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                                            </MultiBinding>
                                                                        </DataGridTextColumn.Binding>
                                                                    </DataGridTextColumn>

                                                                </DataGrid.Columns>

                                                            </DataGrid>

                                                            <Label Name="WarningStructure"
                                                                   Visibility="{Binding WarningStructureError}"
                                                                   Content="{Binding StructureErrorMessage}"
                                                                   Foreground="{StaticResource FaaErrorRed}"
                                                                   Canvas.Top="250" />

                                                        </Canvas>

                                                    </GroupBox>

                                                    <!-- ================================================== -->
                                                    <!-- Design parameters row (Grid layout for alignment)  -->
                                                    <!-- ================================================== -->
                                                    <StackPanel Orientation="Vertical" Canvas.Top="412" Canvas.Left="0" Width="640">

                                                        <!-- Row: Design Life / SCI / CDFU / P-TC Ratio -->
                                                        <Grid Margin="7,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Design Life (Years):"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource FaaTextSecondary}"
                                                                       FontFamily="Segoe UI" FontSize="13"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBox Name="DesignlifeInput"
                                                                     Grid.Column="1"
                                                                     Width="50" Height="28"
                                                                     VerticalAlignment="Center"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding Path=DesignLife, UpdateSourceTrigger=PropertyChanged}">
                                                                <i:Interaction.Behaviors>
                                                                    <utils:EventToCommandBehavior Command="{Binding DesignLife_LostFocus_Command}" Event="LostFocus" PassArguments="True" />
                                                                </i:Interaction.Behaviors>
                                                            </TextBox>

                                                            <TextBlock Grid.Column="3" Text="SCI:"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource FaaTextSecondary}"
                                                                       FontFamily="Segoe UI" FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       Visibility="{Binding Path = AnalysisType, Converter={StaticResource CdfuSciConverter} }"/>
                                                            <TextBox Name="SCIInput"
                                                                     Grid.Column="4"
                                                                     Width="50" Height="28"
                                                                     VerticalAlignment="Center"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding Path=Sci, Mode=TwoWay}"
                                                                     Visibility="{Binding Path = AnalysisType, Converter={StaticResource CdfuSciConverter} }">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter"
                                                                                Command="{Binding Path=SciEnter, UpdateSourceTrigger=PropertyChanged }"
                                                                                CommandParameter="{Binding ElementName=SCIInput, Path=Text}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>

                                                            <TextBlock Grid.Column="6" Text="Percent CDFU:"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource FaaTextSecondary}"
                                                                       FontFamily="Segoe UI" FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       Visibility="{Binding Path = AnalysisType, Converter={StaticResource CdfuSciConverter} }"/>
                                                            <TextBox Name="CdfuInput"
                                                                     Grid.Column="7"
                                                                     Width="52" Height="28"
                                                                     VerticalAlignment="Center"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding Path=Cdfu, Mode=TwoWay}"
                                                                     Visibility="{Binding Path = AnalysisType, Converter={StaticResource CdfuSciConverter} }">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter"
                                                                                Command="{Binding Path=CdfuEnter, UpdateSourceTrigger=PropertyChanged }"
                                                                                CommandParameter="{Binding ElementName=CdfuInput, Path=Text}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>

                                                            <TextBlock Grid.Column="9" Text="P/TC Ratio:"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource FaaTextSecondary}"
                                                                       FontFamily="Segoe UI" FontSize="13"
                                                                       Margin="0,0,6,0"
                                                                       Visibility="{Binding Path = CurrentSectionView.Section.SelectedRun, Converter={StaticResource PtoTCRatioConverter} }"/>
                                                            <TextBox Name="PtoTCInput"
                                                                     Grid.Column="10"
                                                                     Width="50" Height="28"
                                                                     VerticalAlignment="Center"
                                                                     VerticalContentAlignment="Center"
                                                                     Text="{Binding Path=PtoTC, Mode=TwoWay}"
                                                                     Visibility="{Binding Path = CurrentSectionView.Section.SelectedRun, Converter={StaticResource PtoTCRatioConverter} }">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter"
                                                                                Command="{Binding Path=PtoTCEnter, UpdateSourceTrigger=PropertyChanged }"
                                                                                CommandParameter="{Binding ElementName=PtoTCInput, Path=Text}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </Grid>

                                                        <!-- Helper text (Problem 2: secondary style, smaller, indented under textbox) -->
                                                        <TextBlock Text="The standard design life for pavement structure is 20 years (1 to 50 allowed)."
                                                                   Foreground="{StaticResource FaaTextSecondary}"
                                                                   FontFamily="Segoe UI" FontSize="10.5"
                                                                   Margin="7,4,0,0"/>

                                                        <!-- Slab Stress (conditional) -->
                                                        <GroupBox Header="Slab Stress"
                                                                  Width="640"
                                                                  Margin="0,16,0,0"
                                                                  Visibility="{Binding Path = SlabOptions, Converter={StaticResource BooleanToVisibilityConverter} }">
                                                            <Grid Margin="4,4,4,4">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Slab Edge Stress"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           Foreground="{StaticResource FaaTextSecondary}" FontFamily="Segoe UI" FontSize="13"/>
                                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Foreground="{StaticResource FaaTextPrimary}" Text="{Binding EdgeStressLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBox Name="SlabEdgeStress" Width="65" Height="28" IsReadOnly="True"
                                                                             VerticalContentAlignment="Center"
                                                                             Text="{Binding Path = SlabEdgeStress, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Slab Interior Stress"
                                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                                           Foreground="{StaticResource FaaTextSecondary}" FontFamily="Segoe UI" FontSize="13"/>
                                                                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Foreground="{StaticResource FaaTextPrimary}" Text="{Binding InteriorStressLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBox Name="SlabInteriorStress" Width="65" Height="28" IsReadOnly="True"
                                                                             VerticalContentAlignment="Center"
                                                                             Text="{Binding Path = SlabInteriorStress, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                                                                           Foreground="{StaticResource FaaTextPrimary}"
                                                                           Margin="0,6,0,0"
                                                                           Text="{Binding Path=AircraftStressLabel, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </GroupBox>

                                                        <!-- Results section (Problem 3: 16px spacing before section, Problem 4: computed output styling) -->
                                                        <GroupBox Header="Results"
                                                                  Width="640"
                                                                  Margin="0,16,0,0">
                                                            <Grid Margin="4,8,4,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="Calculated Life (Years):"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource FaaTextSecondary}"
                                                                           FontFamily="Segoe UI" FontSize="13"
                                                                           Margin="0,0,6,0"/>
                                                                <Border Grid.Column="1"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{StaticResource FaaBorderGray}"
                                                                        Background="#F0F7F0"
                                                                        CornerRadius="2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Name="CalculatedLife"
                                                                               Padding="8,5"
                                                                               MinWidth="70"
                                                                               Height="28"
                                                                               Foreground="{StaticResource FaaPrimary}"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding CalculatedLife}"/>
                                                                </Border>

                                                                <TextBlock Grid.Column="2"
                                                                           Foreground="{StaticResource FaaTextPrimary}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"
                                                                           Text="{Binding UnitLabel}"/>

                                                                <Border Grid.Column="4"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{StaticResource FaaBorderGray}"
                                                                        Background="#F0F7F0"
                                                                        CornerRadius="2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Name="TotalThicknessUpdate"
                                                                               Padding="8,5"
                                                                               MinWidth="50"
                                                                               Height="28"
                                                                               Foreground="{StaticResource FaaPrimary}"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding TotalThicknessUpdate}"/>
                                                                </Border>
                                                            </Grid>
                                                        </GroupBox>

                                                    </StackPanel>
                                                    
                                                    
                                                    <TabControl Canvas.Left="650"
                                                                Canvas.Top="5"
                                                                Width="540"
                                                                Height="590"
                                                                HorizontalAlignment="Stretch"
                                                                SelectedIndex="{Binding SelectedTabIndex}">
                                                        <TabItem Header="Status">
                                                            <Grid Height="580"
                                                                  Width="520"
                                                                  VerticalAlignment="Top"
                                                                  HorizontalAlignment="Stretch">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Progress banner (visible during and after analysis) -->
                                                                <Border Grid.Row="0"
                                                                        Visibility="{Binding ProgressBannerVisibility}"
                                                                        Margin="4,4,4,0"
                                                                        CornerRadius="4"
                                                                        Padding="0"
                                                                        Background="{Binding ProgressBannerBackground}"
                                                                        BorderBrush="{Binding ProgressBarBrush}"
                                                                        BorderThickness="3,0,0,0">
                                                                    <StackPanel Margin="12,10">
                                                                        <!-- Header row: status icon + text + elapsed time -->
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding ProgressIcon}"
                                                                                       FontSize="20"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,10,0"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding ProgressStatusText}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{Binding ProgressTextBrush}"
                                                                                       FontFamily="Segoe UI"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding TimerText}"
                                                                                       FontSize="14"
                                                                                       FontWeight="SemiBold"
                                                                                       FontFamily="Consolas"
                                                                                       Foreground="{Binding ProgressTextBrush}"
                                                                                       Visibility="{Binding TimerVisibility}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <!-- Progress bar with percentage overlay -->
                                                                        <Grid Margin="0,8,0,0">
                                                                            <ProgressBar Height="16"
                                                                                         IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                                                                         Value="{Binding ProgressValue}"
                                                                                         Maximum="100"
                                                                                         Foreground="{Binding ProgressBarBrush}"
                                                                                         Background="#E0E0E0"
                                                                                         BorderThickness="0"/>
                                                                            <TextBlock Text="{Binding ProgressPercentText}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="9"
                                                                                       FontWeight="SemiBold"
                                                                                       FontFamily="Segoe UI"
                                                                                       Foreground="White"/>
                                                                        </Grid>
                                                                        <!-- Subtitle (cross-section info, iteration, etc.) -->
                                                                        <TextBlock Text="{Binding ProgressSubText}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="{Binding ProgressSubTextBrush}"
                                                                                   FontFamily="Segoe UI"
                                                                                   Margin="0,4,0,0"
                                                                                   Visibility="{Binding ProgressSubTextVisibility}"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Main message display with run log -->
                                                                <Border Grid.Row="1"
                                                                        Margin="4,4,4,0"
                                                                        CornerRadius="3"
                                                                        BorderBrush="{StaticResource FaaBorderGrayLight}"
                                                                        BorderThickness="1"
                                                                        Background="{StaticResource FaaSurfaceOffWhite}">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Top"
                                                                                   Text="Run Log"
                                                                                   FontFamily="Segoe UI"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource FaaTextSecondary}"
                                                                                   Margin="8,6,8,4"/>
                                                                        <TextBox IsReadOnly="True"
                                                                                 TextWrapping="Wrap"
                                                                                 VerticalScrollBarVisibility="Auto"
                                                                                 BorderThickness="0"
                                                                                 Background="Transparent"
                                                                                 FontFamily="Consolas"
                                                                                 FontSize="11"
                                                                                 Foreground="{StaticResource FaaTextPrimary}"
                                                                                 Padding="8,2,8,8"
                                                                                 Text="{Binding MessageText}"/>
                                                                    </DockPanel>
                                                                </Border>

                                                                <!-- Legacy overlays (kept for RunningTime/Stopwatch positional compat) -->
                                                                <TextBox Name="RunningTime"
                                                                         IsReadOnly="true"
                                                                         Foreground="{StaticResource FaaPrimary}" Background="{StaticResource FaaSurfaceWhite}"
                                                                         BorderBrush="Transparent" BorderThickness="0"
                                                                         Height="1" Width="1" Opacity="0"
                                                                         Text="{Binding RunningTimeText}"
                                                                         Visibility="{Binding RunningTimeVisibility}" />
                                                                <TextBox Name="StopWatch"
                                                                         IsReadOnly="true"
                                                                         Foreground="{StaticResource FaaPrimary}"
                                                                         BorderBrush="Transparent" BorderThickness="0"
                                                                         Height="1" Width="1" Opacity="0"
                                                                         Text="{Binding StopwatchText}"
                                                                         Visibility="{Binding StopwatchVisibility}" />
                                                                <TextBox Name="CrossSection"
                                                                         IsReadOnly="true"
                                                                         Foreground="{StaticResource FaaPrimary}" Background="{StaticResource FaaSurfaceWhite}"
                                                                         BorderBrush="Transparent" BorderThickness="0"
                                                                         Height="1" Width="1" Opacity="0"
                                                                         Text="{Binding CrossSectionText}"
                                                                         Visibility="{Binding CrossSectionVisibility}" />
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="Gear" Name="GearCo" >

                                                            <Grid Height="580"
                                                                  Width="520"
                                                                  VerticalAlignment="Top"
                                                                  HorizontalAlignment="Stretch">

                                                                <Image Source="{Binding GearImage}"
                                                                       VerticalAlignment="Top"
                                                                       HorizontalAlignment="Stretch">

                                                                    <i:Interaction.Behaviors>
                                                                        <utils:EventToCommandBehavior Command="{Binding OnGearMouseMove_Command}" Event="MouseMove" PassArguments="True" />
                                                                    </i:Interaction.Behaviors>

                                                                </Image>

                                                                <TextBox Name="XWCoordinate1"
														                 Visibility="{Binding XWCoordinate1Visibility}"
														                 Text="{Binding XWCoordinate1Text}"
														                 Margin="-200,-380,0,0"
														                 Foreground="{StaticResource FaaErrorRed}"
														                 IsReadOnly="True"
														                 Height="70"
														                 Width="130" />
                                                                <TextBox Name="XWCoordinate2"
                                                                         Visibility="{Binding XWCoordinate2Visibility}"
                                                                         Text="{Binding XWCoordinate2Text}"
                                                                         Margin="-200,240,0,0"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="70"
                                                                         Width="130" />
                                                                <TextBox Name="XWCoordinate3"
                                                                         Visibility="{Binding XWCoordinate3Visibility}"
                                                                         Text="{Binding XWCoordinate3Text}"
                                                                         Margin="200,-380,0,0"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="70"
                                                                         Width="130" />
                                                                <TextBox Name="XWCoordinate4"
                                                                         Visibility="{Binding XWCoordinate4Visibility}"
                                                                         Text="{Binding XWCoordinate4Text}"
                                                                         Margin="200,240,0,0"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="70"
                                                                         Width="130" />
                                                                <TextBox Name="XWCoordinate7"
                                                                         Visibility="{Binding XWCoordinate7Visibility}"
                                                                         Text="{Binding XWCoordinate7Text}"
                                                                         Margin="-200,-380,0,0"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="70"
                                                                         Width="130" />
                                                                <TextBox Name="XWCoordinate8"
                                                                         Visibility="{Binding XWCoordinate8Visibility}"
                                                                         Text="{Binding XWCoordinate8Text}"
                                                                         Margin="200,-380,0,0"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="70"
                                                                         Width="130" />
                                                                <TextBox Name="XWCoordinate5"
                                                                         Margin="250,360,0,0"
                                                                         Visibility="{Binding XWCoordinate5Visibility}"
                                                                         Text="{Binding XWCoordinate5Text}"
                                                                         TextAlignment="Center"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="30"
                                                                         Width="75" />
                                                                <TextBox Name="XWCoordinate6"
                                                                         Margin="-250,360,0,0"
                                                                         Visibility="{Binding XWCoordinate6Visibility}"
                                                                         Text="{Binding XWCoordinate6Text}"
                                                                         TextAlignment="Center"
                                                                         Foreground="{StaticResource FaaErrorRed}"
                                                                         IsReadOnly="True"
                                                                         Height="30"
                                                                         Width="75" />
                                                                <Button Padding="0"
                                                                        Height="28"
                                                                        Width="160"
                                                                        Margin="0,495,0,0"
                                                                        Command="{Binding GearImageToClipboardCommand}">Copy Gear to Clipboard</Button>
                                                            </Grid>

                                                        </TabItem>

                                                        <TabItem Header="Structure" Name="Structure" Visibility="{Binding ImageVisibility}">

                                                            <Border CornerRadius="2" Background="{StaticResource FaaSurfaceWhite}" Margin="4">
                                                                <Border.Effect>
                                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.12" Direction="270" Color="Black"/>
                                                                </Border.Effect>
                                                            <Viewbox Height="580"
                                                                  Width="520" VerticalAlignment="Top" >

                                                                <Grid Height="690"
                                                                  Width="640"
                                                                  VerticalAlignment="Top"
                                                                  HorizontalAlignment="Left"
                                                                  Visibility="{Binding ImageVisibility}">

                                                                    <Image Source="{Binding ProfileImage, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                                                                    <ContentPresenter Content="{StaticResource StructureImageButton}" Margin="{Binding StructureListView_Margin}"></ContentPresenter>

                                                                    <Button Padding="0"
													                    Height="28"
													                    Width="190"
													                    Margin="0,640,0,0"
													                    Command="{Binding LayerImageToClipboardCommand}">Copy Structure to Clipboard</Button>

                                                                </Grid>

                                                            </Viewbox>                                                           
                                                            </Border>
                                                           
                                                        </TabItem>

                                                    </TabControl>

                                                </Canvas>
                                            </ScrollViewer>

                                        </telerik:RadPane>
                                    </telerik:RadPaneGroup>

                                    <!-- TRAFFIC CONTAINER -->
                                    <telerik:RadPaneGroup telerik:ProportionalStackPanel.RelativeSize="1000, 300" telerik:RadDocking.SerializationTag="TrafficGroup" >
                                        <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" Header="Traffic"
									                     IsHidden="{Binding AirplanesIsHidden, Mode=TwoWay}"
									                     DataContext="{StaticResource MainWindowViewModel}"
									                     telerik:RadDocking.SerializationTag="Airplanes" >

                                            <Grid ClipToBounds="True">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Canvas Grid.Row="0" Height="40">
                                                        <Label Canvas.Left="5" Canvas.Top="5">Stored Aircraft Mix</Label>
                                                        <Button Height="30"
                                                                Width="160"
                                                                Canvas.Left="390"
                                                                Canvas.Top="5"
                                                                Command="{Binding SaveTrafficLibraryCommand}">Save Aircraft Mix to File</Button>
                                                        <Button Height="30"
										                        Width="220"
										                        Canvas.Left="570"
										                        Canvas.Top="5"
										                        IsEnabled="{Binding Path=DeleteTrafficEnabled}"
										                        Command="{Binding DeleteTrafficLibraryCommand}">Clear All Aircraft from List</Button>
                                                        <Button Height="30"
										                        Width="260"
										                        Canvas.Left="810"
										                        Canvas.Top="5"
										                        Command="{Binding DeleteselectedaircraftCommand}"
										                        CommandParameter="{Binding ElementName=Airplanes}">Remove Selected Aircraft from Structure</Button>
                                                        <Button Height="30"
										                        Width="160"
										                        Canvas.Left="1087"
										                        Canvas.Top="5"
										                        IsEnabled="{Binding Path=DeleteAircraftMixEnabled}"
										                        Command="{Binding DeleteSavedFileCommand}">Delete Aircraft Mix File</Button>

                                                        <Label Canvas.Left="550"
                                                               Canvas.Top="5"
                                                               Foreground="{StaticResource FaaErrorRed}"
                                                               Visibility="{Binding WarningAirplanes}">Airplane error label</Label>
                                                        <ComboBox Name="TrafficCombo"
											                      Canvas.Top="5"
											                      Canvas.Left="140"
											                      Width="200"
											                      Height="30"
											                      ItemsSource="{Binding Path=TrafficLibrary}"
											                      SelectedItem="{Binding Path=CurrentLibrary, Mode=TwoWay}"
											                      SelectedIndex="{Binding Path=CurrentLibraryIndex, Mode=TwoWay}" />
                                                    </Canvas>

                                                    <DataGrid Grid.Row="1"
										                      Name="Airplanes"
										                      CanUserAddRows="False"
										                      CanUserDeleteRows="False"
										                      AutoGenerateColumns="False"
										                      ColumnHeaderHeight="50"
                                                              FrozenColumnCount="1"
                                                              SelectedItem="{Binding Path=SelectedAirplane, Mode=TwoWay}"
										                      ItemsSource="{Binding Path=CurrentAirplanes,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										                      AllowDrop="True"
										                      ScrollViewer.CanContentScroll="true" >
                                                    <!--CanUserSortColumns="True"-->
                                                        
                                                        <i:Interaction.Behaviors>
                                                            <utils:EventToCommandBehavior Command="{Binding Dg2_Keyup_Command}" Event="KeyUp" PassArguments="True" />
                                                            <utils:EventToCommandBehavior Command="{Binding Dg2_LostFocus_Command}" Event="LostFocus" PassArguments="True" />                                                            
                                                            <utils:EventToCommandBehavior Command="{Binding DropAirplane_Command}" Event="Drop" PassArguments="True" />
                                                            <utils:EventToCommandBehavior Command="{Binding DataGridBeginEdit_Command}" Event="BeginningEdit" PassArguments="True" />   
                                                            <utils:EventToCommandBehavior Command="{Binding AirplaneGridEndEdit_Command}" Event="CellEditEnding" PassArguments="True" />
                                                            <utils:EventToCommandBehavior Command="{Binding Dg2_CellChanged_Command}" Event="CurrentCellChanged" PassArguments="True" />
                                                        </i:Interaction.Behaviors>

                                                        <DataGrid.ColumnHeaderStyle>
                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource WrappingColumnHeader}"/>
                                                        </DataGrid.ColumnHeaderStyle>

                                                        <DataGrid.CellStyle>
                                                            <Style TargetType="DataGridCell">
                                                                <Setter Property="Background" Value="{StaticResource FaaSurfaceOffWhite}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource FaaPrimaryLight}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource FaaTextPrimary}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGrid.CellStyle>

                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Airplane Name"
															                    IsReadOnly="True"
															                    MinWidth="180"
															                    Binding="{Binding Name}"
															                    Width="Auto"
