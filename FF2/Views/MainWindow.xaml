                                        <RadioButton  Content="P-501 PCC Surface"
                                            Name="PCCSurfaceL"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="24,238,0,271"
                                            IsEnabled="{Binding PCCSurfaceLIsEnabled}" 
                                            IsChecked="{Binding PCCSurfaceLIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="P-501 PCC Overlay (Unbonded)"
                                            Name="PCCOverlayUnL"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="24,263,0,241"
                                            IsEnabled="{Binding PCCOverlayUnLIsEnabled}" 
                                            IsChecked="{Binding PCCOverlayUnLIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="P-501 PCC Overlay on Flexible"
                                            Name="PCCOverlayFL"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="24,288,0,206"
                                            IsEnabled="{Binding PCCOverlayFLIsEnabled}" 
                                            IsChecked="{Binding PCCOverlayFLIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />


                                        <Label Content="Stabilized"
                                    Style="{StaticResource TypeHeadingMedium}"
                                    HorizontalAlignment="Left"
                                    Margin="310,210,0,0"
                                    VerticalAlignment="Top" />

                                        <RadioButton  Content="P-301 Soil Cement Base"
                                            x:Name="P301L"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,238,0,286"
                                            IsEnabled="{Binding P301LIsEnabled}" 
                                            IsChecked="{Binding P301LIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="P-304 Cement Treated Base"
                                            x:Name="P304L"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,263,0,261"
                                            IsEnabled="{Binding P304LIsEnabled}" 
                                            IsChecked="{Binding P304LIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="P-306 Lean Concrete"
                                            x:Name="P306L"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,288,0,236"
                                            IsEnabled="{Binding P306LIsEnabled}" 
                                            IsChecked="{Binding P306LIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="P-401/P-403 HMA Stabilized"
                                            x:Name="HMAStL"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,313,0,211"
                                            IsEnabled="{Binding HMAStLIsEnabled}" 
                                            IsChecked="{Binding HMAStLIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="Variable (flexible)"
                                            x:Name="VariableFl"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,338,0,185"
                                            IsEnabled="{Binding VariableFlIsEnabled}" 
                                            IsChecked="{Binding VariableFlIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />
                                        <RadioButton  Content="Variable (rigid)"
                                            x:Name="VariableRg"
                                            HorizontalAlignment="Left"
                                            Height="20"
                                            Margin="335,363,0,160"
                                            IsEnabled="{Binding VariableRgIsEnabled}" 
                                            IsChecked="{Binding VariableRgIsChecked}" 
                                            Command="{Binding RBSelectionChanged_Command}" />

                                        <Button Content="Add Layer Below"
                                    Command="{Binding AddLayerBelow_Command}"
                                    Name="AddLayerBelow"
                                    HorizontalAlignment="Left"
                                    Margin="30,410,0,0"
                                    VerticalAlignment="Top"
                                    Width="130" />
                                        <Button Content="Add Layer Above"
                                    Command="{Binding AddLayerAbove_Command}"
                                    Name="AddLayerAbove"
                                    HorizontalAlignment="Left"
                                    Margin="170,410,0,0"
                                    VerticalAlignment="Top"
                                    Width="130" />
                                        <Button Content="OK"
                                    Command="{Binding Replace_Command}"
                                    Name="Replace"
                                    HorizontalAlignment="Left"
                                    Margin="310,410,0,0"
                                    VerticalAlignment="Top"
                                    Width="130" />
                                        <Button Content="Delete Layer"
                                    Command="{Binding DeleteLayer_Command}"
                                    Name="DeleteLayer"
                                    HorizontalAlignment="Left"
                                    Margin="450,410,0,0"
                                    VerticalAlignment="Top"
                                    Width="130" />
                                        <Button Content="Cancel"
                                    Command="{Binding CancelMaterial_Command}"
                                    x:Name="Replace_Copy"
                                    HorizontalAlignment="Left"
                                    Margin="250,520,0,0"
                                    VerticalAlignment="Top"
                                    Width="100" />
                                    </Canvas>
                                </GroupBox>

                                <GroupBox Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemUpdateThickness}}"
                                          Style="{StaticResource TypeHeadingSmall}"
                                          Grid.Row="0"
                                          Grid.Column="1">
                                    <Canvas>
                                        <TextBox HorizontalAlignment="Left"
                                         IsEnabled="{Binding Path=ThicknessUpdateEnabled}"
                                        Height="39"
                                        Margin="12,30,0,-88"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top"
                                        Width="120"
                                        RenderTransformOrigin="0.5,0.5" >

                                            <TextBox.Text>
                                                <MultiBinding Converter="{StaticResource ThicknessConverter}">
                                                    <Binding Path="NewThickness" />                                                   
                                                    <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                </MultiBinding>
                                            </TextBox.Text>

                                            <TextBox.Style>
                                                <Style BasedOn="{StaticResource TextBoxStyle}" TargetType="{x:Type TextBox}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource FaaDisabledGray}"/>
                                                            <Setter Property="Background" Value="{StaticResource FaaDisabledGray}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                            
                                        </TextBox>
                                    </Canvas>

                                </GroupBox>

                                <GroupBox Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemUpdateModulus}}"
                                          Style="{StaticResource TypeHeadingSmall}"
                                          Grid.Row="1"
                                          Grid.Column="1">
                                    <Canvas>
                                        <TextBox  Name="NewModulusInput" HorizontalAlignment="Left"
                                                 IsEnabled="{Binding Path=ModulusUpdateEnabled}"
                                        Height="39"
                                        Margin="12,30,0,-88"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top"
                                        Width="120"
                                        RenderTransformOrigin="0.5,0.5">

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction  Command="{Binding MaterialEditorInputLostFocus_Command}" CommandParameter="Modulus"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                            <TextBox.Text >
                                                <MultiBinding Converter="{StaticResource ModulusConverter}">
                                                    <Binding Path="NewModulus" />
                                                    <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                </MultiBinding>
                                            </TextBox.Text>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                        Command="{Binding Path=NewModulusEnter, UpdateSourceTrigger=PropertyChanged }"
                                                        CommandParameter="{Binding ElementName=NewModulusInput, Path=Text}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Canvas>

                                </GroupBox>

                                <GroupBox Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemUpdateRupture}}"
                                          Style="{StaticResource TypeHeadingSmall}"
                                          Grid.Row="2"
                                          Grid.Column="1">
                                    <Canvas>
                                        <TextBox  Name="NewRuptureInput" HorizontalAlignment="Left"
                                                 IsEnabled="{Binding Path=RuptureUpdateEnabled}"
                                        Height="39"
                                        Margin="12,30,0,-88"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top"
                                        Width="120"
                                        RenderTransformOrigin="0.5,0.5">

                                            <TextBox.Text >
                                                <MultiBinding Converter="{StaticResource ModulusConverter}">
                                                    <Binding Path="NewRupture" />
                                                    <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                </MultiBinding>
                                            </TextBox.Text>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                        Command="{Binding Path=NewRuptureEnter, UpdateSourceTrigger=PropertyChanged }"
                                                        CommandParameter="{Binding ElementName=NewRuptureInput, Path=Text}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Canvas>

                                </GroupBox>

                                <GroupBox Header="Update CBR" Style="{StaticResource TypeHeadingSmall}"
                                          Grid.Row="3"
                                          Grid.Column="1">
                                    <Canvas>
                                        <TextBox Name="NewCBRInput" HorizontalAlignment="Left" IsEnabled="{Binding Path=CBRUpdateEnabled}" Height="39" Margin="12,30,0,-88" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.5,0.5" >


                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction  Command="{Binding MaterialEditorInputLostFocus_Command}" CommandParameter="CBR"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                            <TextBox.Text>
                                                <MultiBinding Converter="{StaticResource CbrConverter}">
                                                    <Binding Path="NewCBR"/>
                                                    <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                </MultiBinding>
                                            </TextBox.Text>

                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                        Command="{Binding Path=NewCBREnter, UpdateSourceTrigger=PropertyChanged }"
                                                        CommandParameter="{Binding ElementName=NewCBRInput, Path=Text}" />
                                            </TextBox.InputBindings>
                                        </TextBox>

                                    </Canvas>

                                </GroupBox>

                                <GroupBox Header="{Binding Source={StaticResource MainWindowViewModel}, Path=CurrentJob.DesignOptions.MeasurementSystem ,Converter={StaticResource MeasurementSystemUpdateKvalue}}"
                                          Style="{StaticResource TypeHeadingSmall}"
                                          Grid.Row="4"
                                          Grid.Column="1">
                                    <Canvas>
                                        <TextBox Name="NewKvalueInput" HorizontalAlignment="Left"
                                                 IsEnabled="{Binding Path=KValueUpdateEnabled}"
                                        Height="39"
                                        Margin="12,30,0,-88"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top"
                                        Width="120"
                                        RenderTransformOrigin="0.5,0.5">

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="LostFocus">
                                                    <i:InvokeCommandAction  Command="{Binding MaterialEditorInputLostFocus_Command}" CommandParameter="KValue"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>

                                            <TextBox.Text>
                                                <MultiBinding Converter="{StaticResource SubgradeReactionConverter}">
                                                    <Binding Path="NewKvalue" />
                                                    <Binding Source="{StaticResource MainWindowViewModel}" Path="CurrentJob.DesignOptions.MeasurementSystem" />
                                                </MultiBinding>
                                            </TextBox.Text>
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                        Command="{Binding Path=NewKvalueEnter, UpdateSourceTrigger=PropertyChanged }"
                                                        CommandParameter="{Binding ElementName=NewKvalueInput, Path=Text}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Canvas>

                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>

            </telerik:RadSplitContainer>
        </telerik:RadDocking>

        <!-- Toast Notification Overlay -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,20,0"
                Background="{Binding ToastBackground}"
                BorderBrush="{StaticResource FaaBorderGray}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,10"
                MinWidth="200"
                MaxWidth="380"
                Visibility="{Binding ToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Effect="{Binding Source={StaticResource ToolbarShadowBorder}, Path=Effect}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ToastIcon}"
                           FontSize="16" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{StaticResource FaaTextPrimary}"
                           FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        </Grid>

        <!-- LOGIN POPUP WINDOW -->
        <telerik:RadDocking x:Name="LoginDocking">

            <telerik:RadSplitContainer InitialPosition="FloatingOnly" Name="LoginWindow"
                                       telerik:RadDocking.FloatingLocation="200, 100" telerik:RadDocking.FloatingSize="800,450">
                <telerik:RadPaneGroup x:Name="radPaneGroup4">
                    <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" x:Name="radPane4" Header="PAVEAIR Login" CanUserClose="True" CanUserPin="False"
                                     IsHidden="{Binding LoginWindowIsHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DataContext="{StaticResource MainWindowViewModel}" telerik:RadDocking.SerializationTag="ProgressWindow">
                        <Grid Background="#FFE7E7E7">
                            <TextBox 
                                x:Name="usernameBox" 
                                HorizontalAlignment="Left" Height="33" Margin="199,160,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="311"
                                Text="{Binding Username}"/>
                            <PasswordBox x:Name="pswdBox" HorizontalAlignment="Left" Margin="200,231,0,0" VerticalAlignment="Top" Height="33" Width="311"/>
                            <TextBlock HorizontalAlignment="Left" Margin="199,140,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" RenderTransformOrigin="-0.628,1.339" Width="79"/>
                            <TextBlock HorizontalAlignment="Left" Margin="203,213,0,0" TextWrapping="Wrap" Text="Password" VerticalAlignment="Top" RenderTransformOrigin="-0.628,1.339" Width="79"/>
                            <Button Content="Submit" 
                                    HorizontalAlignment="Left" Margin="199,287,0,0" 
                                    VerticalAlignment="Top" Width="75" Command="{Binding OnLogin_Command}" CommandParameter="{Binding ElementName=pswdBox}"/>
                            <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Left" Margin="202,366,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="324" Height="29" />
                        </Grid>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>


        </telerik:RadDocking>

        <!-- DOWNLOAD PROGRESS POPUP WINDOW (not in use, but it could be useful later on)
        <telerik:RadDocking x:Name="ProgressDocking">
            <telerik:RadSplitContainer InitialPosition="FloatingDockable" Name="ProgressWindow"
                                       telerik:RadDocking.FloatingLocation="500, 300" telerik:RadDocking.FloatingSize="250,200">
                <telerik:RadPaneGroup x:Name="radPaneGroup1">
                    <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" x:Name="radPane1" Header="Download Status" CanUserClose="False" CanUserPin="False"
                                     IsHidden="{Binding ProgressBarWindowIsHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DataContext="{StaticResource MainWindowViewModel}" telerik:RadDocking.SerializationTag="ProgressWindow">
                        <Grid>
                            <TextBlock>Downloading job...</TextBlock>
                            <ProgressBar Height="20" Width="200" IsIndeterminate="True" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>
        </telerik:RadDocking>
        -->
    </DockPanel>

</Window>
