                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Content="FAARFIELD Aircraft Group"
                                    VerticalAlignment="Top" />

                                <ListBox Grid.Row="1"
                                        ItemsSource="{Binding AirplaneGroup}"
