                                    HeaderTemplate="{StaticResource ExplorerTemplate}"
                                    CanUserClose="False"
                                    IsHidden="{Binding ExplorerIsHidden,Mode=TwoWay}">
                        <telerik:RadTreeView Name="NodesTree"
                                            ItemsSource="{Binding Jobs, Mode=TwoWay}">

                            <i:Interaction.Behaviors>
                                <utils:EventToCommandBehavior Command="{Binding OnPreviewMouseRightButtonDown_Command}" Event="PreviewMouseRightButtonDown" PassArguments="True" />
                            </i:Interaction.Behaviors>

                            <telerik:RadTreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type telerik:RadTreeViewItem}">
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,6"/>
                                    <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected"
                                        Value="{Binding IsSelected, Mode=TwoWay}" />

                                    <Setter Property="FontWeight"
                                        Value="Normal" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource FaaHoverGray}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                Value="True">
                                            <Setter Property="FontWeight"
                                                Value="SemiBold" />
                                            <Setter Property="Background" Value="{StaticResource FaaPrimaryLight}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadTreeView.ItemContainerStyle>

                            <telerik:RadTreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Converter={StaticResource TreeNodeIconConverter}}"
                                                   Foreground="{StaticResource FaaPrimary}"
                                                   FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Close Job" Visibility="{Binding  Source={StaticResource MainWindowViewModel}, Path=CloseJobMenuItemVisibility}">
                                                    <i:Interaction.Behaviors>
                                                        <utils:EventToCommandBehavior Command="{Binding Source={StaticResource MainWindowViewModel}, Path=OnCloseJob_Command}" Event="Click" PassArguments="True" />
                                                    </i:Interaction.Behaviors>
                                                </MenuItem>
                                                <MenuItem Header="Copy" >
                                                    <i:Interaction.Behaviors>
                                                        <utils:EventToCommandBehavior Command="{Binding Source={StaticResource MainWindowViewModel}, Path=MenuItemCopy_Command}" Event="Click" PassArguments="True" />
                                                    </i:Interaction.Behaviors>
                                                </MenuItem>
                                                <MenuItem Header="Delete" >
                                                    <i:Interaction.Behaviors>
                                                        <utils:EventToCommandBehavior Command="{Binding Source={StaticResource MainWindowViewModel}, Path=MenuItemDelete_Command}" Event="Click" PassArguments="True" />
                                                    </i:Interaction.Behaviors>
                                                </MenuItem>
                                                <MenuItem Header="Paste" >
                                                    <i:Interaction.Behaviors>
                                                        <utils:EventToCommandBehavior Command="{Binding Source={StaticResource MainWindowViewModel}, Path=MenuItemPaste_Command}" Event="Click" PassArguments="True" />
                                                    </i:Interaction.Behaviors>
                                                </MenuItem>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </telerik:RadTreeView.ItemTemplate>

                        </telerik:RadTreeView>
                    </telerik:RadPane>

                    <telerik:RadPane Style="{StaticResource AnimatedPaneStyle}" Header="Aircraft"
                                    telerik:RadDocking.SerializationTag="Aircraft"
                                    HeaderTemplate="{StaticResource AircraftTemplate}"
                                    CanUserClose="False">

